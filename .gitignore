# secrets
.env
.env.*
!.env.example

# Sponsor Data: everything under data/ (raw, cache, samples, *_NOTES.md, *_SCHEMA.md, areas.json)
/data/
*_NOTES.md
*_SCHEMA.md

# pipeline and server code that embeds Sponsor schema / API details (rule 3)
tools/sponsor/
server/sponsor/

# processed game data: only the synthetic mock set is committed
public/data/*
!public/data/mock/

# decoder files copied from node_modules at build time
public/libs/

# a car model of your own (not ours to redistribute): used locally, never committed
public/models/local/

# Matterport's Showcase SDK bundle (their code, downloaded locally, never committed)
public/mp-bundle/

# build and test output
node_modules/
dist/
shots/
test-results/
playwright-report/
.playwright-profile/
__pycache__/
*.pyc
